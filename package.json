{
	"name": "notebook",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:zero": "zero-cache-dev -p src/schema/zero.ts",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"database:start": "docker compose up",
		"database:push": "drizzle-kit push",
		"database:migrate": "drizzle-kit migrate",
		"database:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@sveltejs/adapter-vercel": "^5.5.2",
		"@sveltejs/kit": "^2.15.3",
		"@sveltejs/vite-plugin-svelte": "^4.0.4",
		"@types/pg": "^8.11.10",
		"autoprefixer": "^10.4.20",
		"drizzle-kit": "^0.22.8",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.14.0",
		"phosphor-svelte": "^3.0.1",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.10",
		"svelte": "^5.18.0",
		"svelte-check": "^4.1.4",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.20.0",
		"vite": "^5.4.11"
	},
	"dependencies": {
		"@neocodemirror/svelte": "^0.0.18",
		"@rocicorp/zero": "^0.11.2025011402",
		"bits-ui": "1.0.0-next.78",
		"drizzle-orm": "^0.33.0",
		"drizzle-zero": "^0.2.0",
		"jose": "^5.9.6",
		"paneforge": "1.0.0-next.2",
		"pg": "^8.13.1",
		"postgres": "^3.4.5",
		"tailwind-merge": "^2.6.0",
		"tailwind-variants": "^0.3.1"
	}
}
